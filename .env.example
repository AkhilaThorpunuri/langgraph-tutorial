# Docker container endpoints from tinitiate-ai-setup (tinitiate-ai-onboarding.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_setup
POSTGRES_USER=ai_admin
POSTGRES_PASSWORD=ai_admin_pw

MINIO_ENDPOINT=http://localhost:9002
MINIO_ACCESS_KEY=ai_admin
MINIO_SECRET_KEY=ai_admin_pw
MINIO_BUCKET=ai-source-data

ELASTIC_URL=http://localhost:9200
ELASTIC_USER=elastic
ELASTIC_PASSWORD=ai_admin_pw
ELASTIC_INDEX=tinitiate_minio_docs

WEBSITES_PORT=8080

# Optional LLM API Keys (at least one for LLM synthesis; falls back cleanly if unset)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
